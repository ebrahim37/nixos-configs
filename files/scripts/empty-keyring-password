#!/usr/bin/env python3

import argparse
import getpass
import sys

import dbus


SERVICE = "org.freedesktop.secrets"
SERVICE_PATH = "/org/freedesktop/secrets"
SERVICE_INTERFACE = "org.freedesktop.Secret.Service"
INTERNAL_INTERFACE = "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface"
COLLECTION_INTERFACE = "org.freedesktop.Secret.Collection"
PROPERTIES_INTERFACE = "org.freedesktop.DBus.Properties"


def secret(session_path, value):
    return dbus.Struct(
        (
            dbus.ObjectPath(session_path),
            dbus.ByteArray(),
            dbus.ByteArray(value.encode()),
            dbus.String("text/plain"),
        ),
        signature="oayays",
    )


def main():
    parser = argparse.ArgumentParser(
        description="Remove the password from a GNOME keyring selected by alias."
    )
    parser.add_argument(
        "alias",
        nargs="?",
        choices=("default", "login"),
        default="default",
        help="keyring alias to modify (default: %(default)s)",
    )
    args = parser.parse_args()

    bus = dbus.SessionBus()
    service_object = bus.get_object(SERVICE, SERVICE_PATH)
    service = dbus.Interface(service_object, SERVICE_INTERFACE)
    collection_path = service.ReadAlias(args.alias)
    if collection_path == "/":
        print(f"No keyring has the {args.alias!r} alias.", file=sys.stderr)
        return 1

    collection = bus.get_object(SERVICE, collection_path)
    collection_properties = dbus.Interface(
        collection, PROPERTIES_INTERFACE
    ).GetAll(COLLECTION_INTERFACE)
    collection_label = str(collection_properties["Label"])

    print(f"This removes encryption from {collection_label!r}.")
    print("Its contents will remain protected at rest by LUKS.")
    if input("Type EMPTY to continue: ") != "EMPTY":
        print("Cancelled.")
        return 1

    current_password = getpass.getpass(
        f"Current password for {collection_label!r}: "
    )
    _, session_path = service.OpenSession(
        "plain",
        dbus.String("", variant_level=1),
    )

    try:
        internal = dbus.Interface(service_object, INTERNAL_INTERFACE)
        internal.ChangeWithMasterPassword(
            collection_path,
            secret(session_path, current_password),
            secret(session_path, ""),
            signature="o(oayays)(oayays)",
        )
    finally:
        session = bus.get_object(SERVICE, session_path)
        dbus.Interface(session, "org.freedesktop.Secret.Session").Close()

    print(f"{collection_label!r} now has an empty password.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (dbus.DBusException, EOFError) as error:
        print(f"Failed: {error}", file=sys.stderr)
        raise SystemExit(1)
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        raise SystemExit(130)
