#!/bin/sh
set -eu

case "${NTFY_PRIORITY:-3}" in
	1|2) urgency="low" ;;
	3|4) urgency="normal" ;;
	5) urgency="critical" ;;
	*) urgency="normal" ;;
esac

title=${NTFY_TITLE:-}
if [ -z "$title" ]; then
	title="ntfy · ${NTFY_TOPIC:-notification}"
fi

click=
if [ -n "${NTFY_RAW:-}" ]; then
	click=$(printf '%s' "$NTFY_RAW" | jq -r '.click // empty' 2>/dev/null) || click=
fi

case "$click" in
	http://*|https://*) ;;
	*)
		exec notify-send \
			--app-name="ntfy" \
			--urgency="$urgency" \
			"$title" \
			"${NTFY_MESSAGE:-}"
		;;
esac

# notify-send waits for the default action, so run it in the background to
# avoid blocking ntfy from delivering subsequent messages.
(
	action=$(notify-send \
		--app-name="ntfy" \
		--urgency="$urgency" \
		--action="default=Open" \
		"$title" \
		"${NTFY_MESSAGE:-}")

	if [ "$action" = "default" ]; then
		exec xdg-open "$click" >/dev/null 2>&1
	fi
) &

exit 0
