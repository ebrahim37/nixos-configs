#!/bin/sh
set -eu

host=$(hostname)
repo=${NIXOS_CONFIG_DIR:-"$HOME/nixos-configs"}

echo "Pulling latest configuration..."
git -C "$repo" pull --ff-only

echo "Updating all flake inputs in $repo..."
nix flake update --flake "$repo"

echo "Rebuilding NixOS for $host..."
exec sudo nixos-rebuild switch --flake "$repo#$host" "$@"
